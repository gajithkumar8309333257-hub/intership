# ============================================================================
# InternMatch Environment Configuration
# ============================================================================
# The app is fully functional out-of-the-box in local offline demo mode!
# To connect to persistent Supabase cloud database & authentication,
# supply your Supabase project credentials below:

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# NOTE FOR DEVELOPERS:
# - NEVER expose your SUPABASE_SERVICE_ROLE_KEY in client code or .env!
# - Run database migrations from: /supabase/migrations/20261014_init_internmatch.sql
